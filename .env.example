# ==============================================================================
# CodeSense AI Environment Configuration Template
# Copy this file to `.env` in the project root and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
POSTGRES_DB=codesense
POSTGRES_USER=codesense
POSTGRES_PASSWORD=codesense
# Standard DATABASE_URL used by Docker, Supabase, Neon, or Render:
DATABASE_URL=postgresql://codesense:codesense@localhost:5432/codesense
CODESENSE_DATABASE_URL=postgresql://codesense:codesense@localhost:5432/codesense

# ------------------------------------------------------------------------------
# 2. Redis & Asynchronous Worker Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CODESENSE_REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Security & JWT Session
# ------------------------------------------------------------------------------
CODESENSE_JWT_SECRET=replace-with-a-long-random-secret-in-production
CODESENSE_JWT_EXPIRATION_MINUTES=1440
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 (1-Click Google Sign-In)
# ------------------------------------------------------------------------------
# Get your Client ID from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Google Gemini Generative AI (LLM Code Review & Explanations)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 6. GitHub Integration & Webhook PR Automation
# ------------------------------------------------------------------------------
# GitHub OAuth App credentials (optional, for web login):
CODESENSE_GITHUB_CLIENT_ID=
CODESENSE_GITHUB_CLIENT_SECRET=
CODESENSE_GITHUB_REDIRECT_URI=http://localhost:8050/api/auth/github/callback

# GitHub Webhook Secret (used by POST /api/webhooks/github to verify HMAC sha256):
GITHUB_WEBHOOK_SECRET=your-secure-webhook-secret
CODESENSE_GITHUB_WEBHOOK_SECRET=your-secure-webhook-secret

# ------------------------------------------------------------------------------
# 7. Frontend Client Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8050/api
