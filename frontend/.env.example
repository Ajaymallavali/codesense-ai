# CodeSense Frontend Environment Variables

# Production Backend API URL (e.g., your deployed Render / Cloud backend)
# Example: https://codesense-backend.onrender.com/api
# In local development, leave empty or point to http://localhost:8050/api
VITE_API_BASE_URL=http://localhost:8050/api

# Optional: Google OAuth Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=
